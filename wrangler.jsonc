{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truyendem",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truyendem-db",
      "database_id": "80fb0f00-9d58-4d13-8338-27b585a4d772"
    }
  ]
}
